{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mni:observation-compatibility:v0",
  "title": "Minecraft Native Intelligence observation compatibility cases v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "consumer_schema_version",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "observation-compatibility.v0"
    },
    "consumer_schema_version": {
      "const": "observation.v0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fixture",
          "mutation",
          "supported_capabilities",
          "expected",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          },
          "fixture": {
            "type": "string",
            "minLength": 1
          },
          "mutation": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op"
                ],
                "properties": {
                  "op": {
                    "enum": [
                      "set_schema_version",
                      "add_required_capability",
                      "add_core_property",
                      "set_path",
                      "set_collection_coverage"
                    ]
                  },
                  "path": {
                    "type": "string"
                  },
                  "value": {},
                  "capability": {
                    "type": "string"
                  },
                  "collection": {
                    "enum": [
                      "geometry",
                      "entities",
                      "events"
                    ]
                  },
                  "status": {
                    "enum": [
                      "complete",
                      "partial",
                      "unavailable"
                    ]
                  },
                  "negative_evidence": {
                    "enum": [
                      "scope_complete",
                      "observed_items_only",
                      "none"
                    ]
                  }
                }
              }
            ]
          },
          "supported_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "enum": [
              "accept",
              "reject"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "absence_claim_allowed": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    }
  }
}
