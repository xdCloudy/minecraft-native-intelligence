{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mni:entity-conformance:v1",
  "title": "Minecraft Native Intelligence entity semantics conformance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics_version",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "entity-conformance.v1"
    },
    "semantics_version": {
      "const": "entity-semantics.v1"
    },
    "scenarios": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "setup",
          "expected",
          "prohibited",
          "prototype_covered"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EID-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "setup": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prohibited": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prototype_covered": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
