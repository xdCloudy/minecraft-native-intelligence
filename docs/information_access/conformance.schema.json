{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mni:information-access-conformance:v1",
  "title": "Minecraft Native Intelligence information-access conformance catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "information-access-conformance.v1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "rules",
          "setup",
          "expected",
          "prohibited"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^IA-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ia\\.[a-z0-9_.-]+$"
            }
          },
          "setup": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prohibited": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
