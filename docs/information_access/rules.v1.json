{
  "schema_version": "information-access.v1",
  "profile_id": "player-equivalent.v1",
  "camera": {
    "base_horizontal_fov_degrees": 70,
    "visual_distance_source": "scenario_declared",
    "debug_overlay": false
  },
  "rules": [
    {
      "id": "ia.self.owned_state",
      "channel": "self",
      "policy": "allow",
      "summary": "Expose declared self-owned proprioceptive, HUD and inventory state; exclude host/server implementation internals.",
      "negative_evidence": "not_applicable",
      "privileged_if_bypassed": false
    },
    {
      "id": "ia.visual.frustum",
      "channel": "vision",
      "policy": "filter",
      "summary": "Visual candidates must be inside the active camera frustum; baseline base horizontal FOV is 70 degrees.",
      "negative_evidence": "unknown_without_coverage",
      "privileged_if_bypassed": true
    },
    {
      "id": "ia.visual.distance",
      "channel": "vision",
      "policy": "filter",
      "summary": "Visual candidates must be inside the scenario-declared effective visual distance and client-equivalent availability.",
      "negative_evidence": "unknown_without_coverage",
      "privileged_if_bypassed": true
    },
    {
      "id": "ia.visual.occlusion",
      "channel": "vision",
      "policy": "filter",
      "summary": "Current visual facts require unobstructed player-facing evidence after geometry and visual-effect filtering.",
      "negative_evidence": "unknown_without_coverage",
      "privileged_if_bypassed": true
    },
    {
      "id": "ia.visual.surface_only",
      "channel": "vision",
      "policy": "filter",
      "summary": "Expose visible block/object surfaces rather than full radius/chunk contents behind them.",
      "negative_evidence": "unknown_without_coverage",
      "privileged_if_bypassed": true
    },
    {
      "id": "ia.entity.visible_properties",
      "channel": "vision",
      "policy": "filter",
      "summary": "For sensed entities expose only current player-facing properties, not hidden health, inventory, AI goals or server-only metadata.",
      "negative_evidence": "unknown_without_coverage",
      "privileged_if_bypassed": true
    },
    {
      "id": "ia.audio.client_delivery",
      "channel": "audio",
      "policy": "filter",
      "summary": "Expose only sounds the equivalent client/player could receive or hear; do not add exact hidden source state.",
      "negative_evidence": "unknown_without_coverage",
      "privileged_if_bypassed": true
    },
    {
      "id": "ia.chat.recipient_delivery",
      "channel": "chat",
      "policy": "filter",
      "summary": "Expose only messages delivered to this player by the active chat/channel/server rules.",
      "negative_evidence": "not_applicable",
      "privileged_if_bypassed": true
    },
    {
      "id": "ia.ui.player_facing",
      "channel": "ui",
      "policy": "explicit_capability",
      "summary": "Expose ordinary non-debug player-facing UI only when the capability is declared; never use it to leak underlying server objects.",
      "negative_evidence": "not_applicable",
      "privileged_if_bypassed": true
    },
    {
      "id": "ia.world.chunk_not_authority",
      "channel": "vision",
      "policy": "deny",
      "summary": "Loaded, ticking, simulated or ticketed chunk state never grants policy perception by itself.",
      "negative_evidence": "unknown_without_coverage",
      "privileged_if_bypassed": true
    },
    {
      "id": "ia.negative.coverage_required",
      "channel": "vision",
      "policy": "filter",
      "summary": "Observed absence is valid only where current sensor coverage is sufficient; otherwise state is unknown.",
      "negative_evidence": "allowed_with_coverage",
      "privileged_if_bypassed": true
    },
    {
      "id": "ia.memory.no_authoritative_refresh",
      "channel": "memory",
      "policy": "deny",
      "summary": "Memory cannot query authoritative unseen server state to refresh or verify remembered facts.",
      "negative_evidence": "not_applicable",
      "privileged_if_bypassed": true
    },
    {
      "id": "ia.protocol.mask_from_policy",
      "channel": "protocol",
      "policy": "mask",
      "summary": "Sequence, schema, trace and exact timing metadata may support transport/evaluation but are not automatically policy-visible.",
      "negative_evidence": "not_applicable",
      "privileged_if_bypassed": true
    },
    {
      "id": "ia.outcome.own_action",
      "channel": "outcome",
      "policy": "allow",
      "summary": "Expose semantic outcomes of this agent's own actions without hidden target/world diagnostics.",
      "negative_evidence": "not_applicable",
      "privileged_if_bypassed": false
    },
    {
      "id": "ia.knowledge.recipe_ui_explicit",
      "channel": "ui",
      "policy": "explicit_capability",
      "summary": "Recipe-book-equivalent access must be explicit; never passively inject the complete server recipe registry.",
      "negative_evidence": "not_applicable",
      "privileged_if_bypassed": true
    },
    {
      "id": "ia.privileged.baseline_off",
      "channel": "privileged",
      "policy": "deny",
      "summary": "Evaluator, operator, debug-overlay and admin-only state is isolated from the baseline policy input.",
      "negative_evidence": "not_applicable",
      "privileged_if_bypassed": true
    }
  ],
  "field_classes": [
    {
      "field_class": "self.pose_motion",
      "channel": "self",
      "access_rule_ids": [
        "ia.self.owned_state"
      ],
      "policy_visible_default": true,
      "unknown_semantics": "not_applicable",
      "notes": "Own position/orientation/motion precision remains a #3 schema decision."
    },
    {
      "field_class": "self.needs_status",
      "channel": "self",
      "access_rule_ids": [
        "ia.self.owned_state"
      ],
      "policy_visible_default": true,
      "unknown_semantics": "not_applicable"
    },
    {
      "field_class": "self.inventory_equipment",
      "channel": "self",
      "access_rule_ids": [
        "ia.self.owned_state"
      ],
      "policy_visible_default": true,
      "unknown_semantics": "not_applicable"
    },
    {
      "field_class": "vision.blocks_surfaces",
      "channel": "vision",
      "access_rule_ids": [
        "ia.visual.frustum",
        "ia.visual.distance",
        "ia.visual.occlusion",
        "ia.visual.surface_only",
        "ia.world.chunk_not_authority",
        "ia.negative.coverage_required"
      ],
      "policy_visible_default": true,
      "unknown_semantics": "coverage_required"
    },
    {
      "field_class": "vision.entities",
      "channel": "vision",
      "access_rule_ids": [
        "ia.visual.frustum",
        "ia.visual.distance",
        "ia.visual.occlusion",
        "ia.entity.visible_properties",
        "ia.world.chunk_not_authority",
        "ia.negative.coverage_required"
      ],
      "policy_visible_default": true,
      "unknown_semantics": "coverage_required"
    },
    {
      "field_class": "audio.events",
      "channel": "audio",
      "access_rule_ids": [
        "ia.audio.client_delivery"
      ],
      "policy_visible_default": true,
      "unknown_semantics": "explicit_unknown"
    },
    {
      "field_class": "chat.messages",
      "channel": "chat",
      "access_rule_ids": [
        "ia.chat.recipient_delivery"
      ],
      "policy_visible_default": true,
      "unknown_semantics": "not_applicable"
    },
    {
      "field_class": "ui.player_facing",
      "channel": "ui",
      "access_rule_ids": [
        "ia.ui.player_facing"
      ],
      "policy_visible_default": false,
      "unknown_semantics": "not_applicable"
    },
    {
      "field_class": "ui.recipe_book",
      "channel": "ui",
      "access_rule_ids": [
        "ia.ui.player_facing",
        "ia.knowledge.recipe_ui_explicit"
      ],
      "policy_visible_default": false,
      "unknown_semantics": "not_applicable"
    },
    {
      "field_class": "outcome.own_action",
      "channel": "outcome",
      "access_rule_ids": [
        "ia.outcome.own_action"
      ],
      "policy_visible_default": true,
      "unknown_semantics": "not_applicable"
    },
    {
      "field_class": "memory.prior_observation",
      "channel": "memory",
      "access_rule_ids": [
        "ia.memory.no_authoritative_refresh"
      ],
      "policy_visible_default": true,
      "unknown_semantics": "explicit_unknown"
    },
    {
      "field_class": "protocol.ordering_trace",
      "channel": "protocol",
      "access_rule_ids": [
        "ia.protocol.mask_from_policy"
      ],
      "policy_visible_default": false,
      "unknown_semantics": "not_applicable"
    },
    {
      "field_class": "privileged.evaluator_operator_debug",
      "channel": "privileged",
      "access_rule_ids": [
        "ia.privileged.baseline_off"
      ],
      "policy_visible_default": false,
      "unknown_semantics": "not_applicable"
    }
  ]
}
