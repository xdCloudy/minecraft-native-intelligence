{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mni:experiment:run:v1",
  "title": "Minecraft Native Intelligence experiment run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "experiment_manifest_sha256",
    "scenario",
    "source_revision",
    "publishable",
    "environment",
    "started_at",
    "ended_at",
    "status",
    "expected_logical_trials",
    "variants",
    "trials",
    "summary",
    "artifact_manifest",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "experiment.run.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 3
    },
    "experiment_id": {
      "type": "string",
      "minLength": 3
    },
    "experiment_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "sha256"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vcs",
        "commit",
        "dirty",
        "dirty_entry_count"
      ],
      "properties": {
        "vcs": {
          "const": "git"
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "dirty": {
          "type": "boolean"
        },
        "dirty_entry_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "publishable": {
      "type": "boolean"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "platform",
        "system",
        "release",
        "machine",
        "processor",
        "environment_variables"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "processor": {
          "type": "string"
        },
        "environment_variables": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "partial",
        "error",
        "cancelled"
      ]
    },
    "expected_logical_trials": {
      "type": "integer",
      "minimum": 1
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trial_id",
          "variant_id",
          "seed",
          "repetition_index",
          "attempt",
          "status",
          "started_at",
          "ended_at",
          "duration_seconds",
          "timeout_seconds",
          "command",
          "working_directory",
          "exit_code",
          "launch_error",
          "artifacts"
        ],
        "properties": {
          "trial_id": {
            "type": "string",
            "minLength": 1
          },
          "variant_id": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "repetition_index": {
            "type": "integer",
            "minimum": 0
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "timeout",
              "error"
            ]
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "command": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "executable",
              "arguments"
            ],
            "properties": {
              "executable": {
                "type": "string",
                "minLength": 1
              },
              "arguments": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "working_directory": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "launch_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "size_bytes",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_status_counts",
        "final_trial_status_counts",
        "logical_trial_count"
      ],
      "properties": {
        "attempt_status_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "final_trial_status_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "logical_trial_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifact_manifest": {
      "const": "artifacts.json"
    },
    "notes": {
      "type": "string"
    }
  }
}
