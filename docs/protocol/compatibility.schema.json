{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mni:protocol-compatibility:v0",
  "title": "MNI environment protocol compatibility cases v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer_fixture", "consumer_fixture", "cases"],
  "properties": {
    "schema_version": { "const": "mni-protocol-compatibility.v0" },
    "producer_fixture": { "type": "string", "minLength": 1 },
    "consumer_fixture": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "producer", "consumer", "expected", "diagnostic"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "producer": { "type": "array", "items": { "$ref": "#/$defs/mutation" } },
          "consumer": { "type": "array", "items": { "$ref": "#/$defs/mutation" } },
          "expected": { "enum": ["accept", "degraded", "reject"] },
          "diagnostic": { "type": "string", "minLength": 1 },
          "diagnostics": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "enabled_capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "omit_capability": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path"],
      "properties": {
        "op": { "enum": ["set", "append"] },
        "path": { "type": "string", "minLength": 1 },
        "value": {}
      }
    }
  }
}
