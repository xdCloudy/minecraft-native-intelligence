{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mni:consumer-policy:v0",
  "title": "Minecraft Native Intelligence consumer compatibility policy v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_major", "max_protocol_minor", "environment_support", "schemas", "capabilities", "allowed_experimental_capabilities"],
  "properties": {
    "schema_version": { "const": "mni-consumer-policy.v0" },
    "protocol_major": { "type": "integer", "minimum": 1 },
    "max_protocol_minor": { "type": "integer", "minimum": 0 },
    "environment_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minecraft_versions", "java_majors", "loaders", "mods", "server_modes"],
      "properties": {
        "minecraft_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "java_majors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 17 } },
        "loaders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "versions"],
            "properties": {
              "id": { "enum": ["fabric", "neoforge", "quilt", "replay", "offline"] },
              "versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "mods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "versions"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
              "versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "server_modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["integrated", "dedicated", "replay", "offline"] } }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation", "action_request", "action_outcome"],
      "properties": {
        "observation": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^observation\\.v[0-9]+$" } },
        "action_request": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^action-request\\.v[0-9]+$" } },
        "action_outcome": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^action-outcome\\.v[0-9]+$" } }
      }
    },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" } },
    "allowed_experimental_capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" } }
  }
}
